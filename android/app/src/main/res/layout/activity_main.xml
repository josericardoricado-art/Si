<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#06152F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/si_logo"
            android:contentDescription="SI Tradutor Live" />

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="SI TRADUTOR LIVE"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tradução e dublagem em tempo real"
            android:textColor="#B8C7DD"
            android:textSize="15sp"
            android:gravity="center" />

        <!-- STATUS -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:padding="16dp"
            android:background="#10264A"
            android:text="Verificando servidor..."
            android:textColor="#20E879"
            android:textSize="15sp"
            android:gravity="center"
            android:textStyle="bold" />

        <!-- MONITORAR TELA -->
        <Button
            android:id="@+id/monitorButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="25dp"
            android:text="🎬  MONITORAR TELA"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#168BFF" />

        <!-- PARAR -->
        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="⏹  PARAR MONITORAMENTO"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:enabled="false"
            android:backgroundTint="#263B5C" />

        <!-- IDIOMA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="🌎  Idioma da tradução"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/languageSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF" />

        <!-- DUBLAGEM -->
        <Button
            android:id="@+id/dubbingButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="18dp"
            android:text="🔊  DUBLAGEM ATIVADA"
            android:textColor="#06152F"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#20E879" />

        <!-- TRADUÇÃO -->
        <Button
            android:id="@+id/translationButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="🌐  TRADUÇÃO ATIVADA"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#168BFF" />

        <!-- CADASTRO -->
        <Button
            android:id="@+id/registerButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="28dp"
            android:text="👤  CADASTRAR / ENTRAR"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#10264A" />

        <!-- PLANOS -->
        <Button
            android:id="@+id/plansButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="💳  VER PLANOS"
            android:textColor="#06152F"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#20E879" />

        <!-- EXPLICAÇÃO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="25dp"
            android:text="Abra seu vídeo no YouTube, TikTok, Instagram, Twitch ou outro aplicativo. Depois volte ao SI Tradutor Live e toque em MONITORAR TELA."
            android:textColor="#B8C7DD"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</ScrollView>
