<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020B1C"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="22dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/si_logo"
            android:scaleType="fitCenter"
            android:contentDescription="SI Tradutor Live" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SI Tradutor Live"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tradução e dublagem em tempo real"
            android:textColor="#7DCBFF"
            android:textSize="16sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="25dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#071A35"
            android:padding="18dp"
            android:text="🟢 Pronto para traduzir"
            android:textColor="#20E879"
            android:textSize="17sp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:text="🎙️  INICIAR TRADUÇÃO"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#087FF5"
            android:layout_marginBottom="15dp" />

        <!-- CAMPO DO LINK -->

        <EditText
            android:id="@+id/socialUrl"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Cole aqui o link do vídeo ou live"
            android:textColor="#FFFFFF"
            android:textColorHint="#7894B5"
            android:inputType="textUri"
            android:singleLine="true"
            android:padding="16dp"
            android:backgroundTint="#168BFF"
            android:layout_marginBottom="15dp" />

        <Button
            android:id="@+id/dubButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🚀  DUBLAR ESTE VÍDEO"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:backgroundTint="#12345C"
            android:layout_marginBottom="15dp" />

        <Button
            android:id="@+id/microphoneButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="🎤  LIGAR MICROFONE"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#12345C"
            android:layout_marginBottom="15dp" />

        <Button
            android:id="@+id/translationButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="🌎  TRADUÇÃO"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#12345C"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#071A35"
            android:padding="18dp"
            android:text="🇧🇷  Idioma de saída: Português"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#071A35"
            android:padding="18dp"
            android:text="🌐  Cole um link de vídeo ou live para iniciar."
            android:textColor="#A9C7E8"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="25dp" />

    </LinearLayout>

</ScrollView>
