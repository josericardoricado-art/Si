<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:src="@drawable/si_logo"
            android:contentDescription="SI Tradutor Live"
            android:scaleType="fitCenter"
            android:layout_marginBottom="20dp" />

        <!-- NOME -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SI Tradutor Live"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tradução em tempo real"
            android:textSize="16sp"
            android:layout_marginBottom="30dp" />

        <!-- STATUS -->
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pronto para traduzir"
            android:textSize="18sp"
            android:layout_marginBottom="25dp" />

        <!-- BOTÃO -->
        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎙️ Iniciar tradução"
            android:textSize="18sp"
            android:layout_marginBottom="15dp" />

        <!-- MICROFONE -->
        <Button
            android:id="@+id/microphoneButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎤 Ligar microfone"
            android:textSize="17sp"
            android:layout_marginBottom="15dp" />

        <!-- TRADUÇÃO -->
        <Button
            android:id="@+id/translationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌎 Tradução"
            android:textSize="17sp" />

    </LinearLayout>

</ScrollView>
